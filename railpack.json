{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["env -u NPM_CONFIG_PRODUCTION npm install"]
    },
    "build": {
      "commands": ["env -u NPM_CONFIG_PRODUCTION npm run build"]
    }
  },
  "deploy": {
    "startCommand": "env -u NPM_CONFIG_PRODUCTION npm run start"
  }
}
