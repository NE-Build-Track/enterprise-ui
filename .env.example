# Public origin of the livepeer-builder engine, with no trailing path.
LPB_ENGINE_URL=https://engine.example

# Orchestrator discovery. Request forms are built from runner schema_url metadata, not /v1/offerings.
LPB_DISCOVERY_URL=https://orchestrator.example/discovery

# Engine admin key (lpk_). Server-only. Never expose this to the browser.
LPB_ADMIN_TOKEN=

# Application id shared by the demo's allocations.
LPB_APPLICATION_ID=default

# 32+ random bytes, any string. Used to encrypt the session cookie.
SESSION_SECRET=

# When set, /signup will issue an actor key for a pre-provisioned actor.
# Leave empty to disable public signup. Issuing a key does not move money.
SIGNUP_INVITE_CODE=

# GitHub URL used by `npm create livepeer-enterprise` after this repo is published.
NEXT_PUBLIC_EXAMPLE_REPO_URL=
